# Smart Student Productivity Assistant - Frontend environment variables
#
# Single-origin deployment (recommended): leave VITE_API_URL empty.
# The frontend will call relative /api on the same HTTPS domain that serves it.
#
# Split deployment (frontend on Vercel, backend on Render/etc.):
# Set VITE_API_URL to the backend's public HTTPS base URL at BUILD time, e.g.
# VITE_API_URL=https://your-backend.example.com
VITE_API_URL=
