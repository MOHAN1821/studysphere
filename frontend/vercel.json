{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "regions": ["iad1"],
  "env": {
    "VITE_API_URL": "https://smart-student-productivity-assistant.onrender.com"
  },
  "routes": [
    { "src": "/assets/(.*)", "headers": { "cache-control": "s-maxage=31536000, immutable" }, "status": 200 },
    { "src": "/(.*)", "dest": "/index.html", "status": 200 }
  ]
}
