# StudySphere / Smart Student Productivity Assistant backend configuration
# Copy to backend/.env for local dev. In production set these as platform env vars.
# Never commit real secrets.

# --- CORS (production) ---
# Comma-separated list of allowed public HTTPS origins. Example:
# CORS_ORIGINS=https://app.example.com,https://www.app.example.com
# Leave empty for local/dev wildcard (not recommended for production).
CORS_ORIGINS=

# --- AI configuration ---
# Required variables:
#   AI_PROVIDER = openai | anthropic | gemini | groq | openrouter | custom
#   AI_API_KEY  = your provider API key
#
AI_PROVIDER=anthropic
AI_API_KEY=

# Optional: override the default model.
# AI_MODEL=claude-sonnet-5-5   # default; cheaper/faster: claude-haiku-5-5

# Required only for provider=custom (OpenAI-compatible endpoint).
# AI_BASE_URL=https://your-endpoint.example/v1

# --- Production essentials ---
# Long random string used to sign logins. Same value for every worker/restart.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Folder for the SQLite database. MUST be a persistent disk/volume in the cloud.
# DATA_DIR=/var/data
# Set true when the site is served over HTTPS (any public URL).
COOKIE_SECURE=false
# WEB_CONCURRENCY=2
# GUNICORN_TIMEOUT=120

# --- Future (not wired in this SQLite build) ---
# DATABASE_URL=postgresql://user:pass@host:5432/dbname